{
  "name": "@reviewjs/annotate",
  "version": "1.4.0",
  "description": "A drop-in visual review and annotation layer for any website. Store comments locally, export JSON, or send feedback to your own endpoint.",
  "main": "annotate.js",
  "module": "annotate.mjs",
  "types": "annotate.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./annotate.d.mts",
        "default": "./annotate.mjs"
      },
      "require": {
        "types": "./annotate.d.cts",
        "default": "./annotate.js"
      },
      "default": "./annotate.js"
    },
    "./annotate.js": {
      "types": "./annotate.d.cts",
      "default": "./annotate.js"
    },
    "./annotate.mjs": {
      "types": "./annotate.d.mts",
      "default": "./annotate.mjs"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "annotate.js",
  "jsdelivr": "annotate.js",
  "files": [
    "annotate.js",
    "annotate.mjs",
    "annotate.d.ts",
    "annotate.d.mts",
    "annotate.d.cts",
    "examples/feedback-server.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npx serve . --listen 4200 --no-clipboard",
    "demo": "npx serve . --listen 4200 --no-clipboard",
    "pages:build": "npm run build && rm -rf _site && mkdir -p _site && cp index.html annotate.js annotate.mjs annotate.d.ts annotate.d.mts annotate.d.cts logo.png og-image.png .nojekyll CNAME LICENSE README.md package.json _site/ && cp -R examples _site/examples",
    "deploy:pages": "npm run pages:build",
    "prepack": "npm run build",
    "publish:npm": "npm publish --access public",
    "test:server": "node --test scripts/tests/feedback-server.test.cjs",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "annotation",
    "comments",
    "review",
    "feedback",
    "highlight",
    "markup",
    "proofing",
    "no-backend",
    "localstorage",
    "vanilla-js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reviewjs/annotate.git"
  },
  "homepage": "https://reviewjs.com",
  "bugs": {
    "url": "https://github.com/reviewjs/annotate/issues"
  },
  "directories": {
    "example": "examples"
  },
  "author": "Akash Goswami",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "serve": "^14.2.6"
  }
}
