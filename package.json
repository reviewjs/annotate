{
  "name": "@reviewjs/annotate",
  "version": "1.6.0",
  "description": "A drop-in visual review and annotation layer for any website. Store comments locally, export JSON, or send feedback to your own endpoint.",
  "main": "annotate.js",
  "module": "annotate.mjs",
  "types": "annotate.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./annotate.d.mts",
        "default": "./annotate.mjs"
      },
      "require": {
        "types": "./annotate.d.cts",
        "default": "./annotate.js"
      },
      "default": "./annotate.js"
    },
    "./annotate.js": {
      "types": "./annotate.d.cts",
      "default": "./annotate.js"
    },
    "./annotate.mjs": {
      "types": "./annotate.d.mts",
      "default": "./annotate.mjs"
    },
    "./firebase": {
      "types": "./firebase.d.ts",
      "default": "./firebase.mjs"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "annotate.js",
  "jsdelivr": "annotate.js",
  "files": [
    "annotate.js",
    "annotate.mjs",
    "annotate.d.ts",
    "annotate.d.mts",
    "annotate.d.cts",
    "examples/feedback-server.cjs",
    "examples/annotate-server.cjs",
    "firebase.mjs",
    "firebase.d.ts",
    "examples/firebase/firestore.rules",
    "examples/firebase/firestore.indexes.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npx serve . --listen 4200 --no-clipboard",
    "demo": "npx serve . --listen 4200 --no-clipboard",
    "pages:build": "npm run build && rm -rf _site && mkdir -p _site && cp index.html annotate.js annotate.mjs annotate.d.ts annotate.d.mts annotate.d.cts logo.png og-image.png .nojekyll CNAME LICENSE README.md package.json _site/ && cp -R examples _site/examples",
    "deploy:pages": "npm run pages:build",
    "version": "node scripts/set-version.mjs && npm run build && git add -A",
    "prepack": "npm run build",
    "publish:npm": "npm publish --access public",
    "test:server": "node --test scripts/tests/feedback-server.test.cjs scripts/tests/annotate-server.test.cjs",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:report": "playwright show-report",
    "test:firebase": "firebase emulators:exec --config examples/firebase/firebase.json --only auth,firestore --project demo-annotate \"node --test scripts/tests/firebase-transport.test.mjs scripts/tests/firestore-rules.test.mjs\"",
    "test:firebase:e2e": "firebase emulators:exec --config examples/firebase/firebase.json --only auth,firestore --project demo-annotate \"node scripts/build-firebase-e2e.mjs && playwright test tests/firebase.spec.js --project=chromium\""
  },
  "keywords": [
    "annotation",
    "comments",
    "review",
    "feedback",
    "highlight",
    "markup",
    "proofing",
    "no-backend",
    "localstorage",
    "vanilla-js",
    "firebase",
    "firestore",
    "realtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reviewjs/annotate.git"
  },
  "homepage": "https://reviewjs.com",
  "bugs": {
    "url": "https://github.com/reviewjs/annotate/issues"
  },
  "directories": {
    "example": "examples"
  },
  "author": "Akash Goswami",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.61.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "serve": "^14.2.6"
  },
  "peerDependencies": {
    "firebase": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  }
}
